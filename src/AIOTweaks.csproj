<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AIOTweaks</RootNamespace>
    <AssemblyName>AIOTweaks</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>AIOTweaks Team</Authors>
    <Description>All-in-one customizable settings, tweak suite, and debug toolkit for Slay the Spire 2.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <Reference Include="sts2">
      <HintPath Condition="'$(Sts2Path)' != ''">$(Sts2Path)</HintPath>
      <HintPath Condition="'$(Sts2Path)' == ''">/mnt/data/SteamLibrary/steamapps/common/Slay the Spire 2/data_sts2_linuxbsd_x86_64/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath Condition="'$(BaseLibPath)' != ''">$(BaseLibPath)</HintPath>
      <HintPath Condition="'$(BaseLibPath)' == ''">/mnt/data/SteamLibrary/steamapps/workshop/content/2868840/3737335127/BaseLib/BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../AIOTweaks.json" Link="AIOTweaks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

